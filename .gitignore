# --- Python Artifacts ---
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
ENV/
env/

# --- Scrapy Specifics ---
# Local Scrapy configuration (can contain machine-specific overrides)
.scrapy/

# --- Data Outputs (Crucial for Scrapy) ---
# Don't push your crawled data, logs, or reports to GitHub
*.json
*.csv
*.xml
*.jl
*.log

# Exceptions: If you intentionally have a small sample dataset in a specific folder, 
# you can allow it, but generally keep crawled data out of git.

# --- Environment Variables & Secrets ---
# Crucial for Proxy credentials, API keys, or Database passwords
.env
*.env
secrets.json

# --- OS & IDE Specifics ---
.DS_Store
.idea/
.vscode/